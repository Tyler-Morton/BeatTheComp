# Anthropic key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Alpaca paper trading keys from https://app.alpaca.markets
# Paper only. The bot refuses to start on any ALPACA_BASE_URL that isn't a paper URL.
ALPACA_API_KEY=PK...
ALPACA_SECRET_KEY=...
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional email alerts. For Gmail, make an App Password at https://myaccount.google.com/apppasswords
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-app-password

# Second paper account, for the challenger (challenger/main.py)
CHALLENGER_ALPACA_API_KEY=
CHALLENGER_ALPACA_SECRET_KEY=

# Third paper account, for VolBot (volbot/)
VOLBOT_ALPACA_API_KEY=
VOLBOT_ALPACA_SECRET_KEY=

# Daily prices for the challenger, from https://www.tiingo.com
TIINGO_API_KEY=
